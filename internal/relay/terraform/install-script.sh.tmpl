#!/bin/bash
set -euo pipefail

# Tunnel Whisperer — Relay Install Script
# Domain: {{.Domain}}
#
# Run as root on a fresh Ubuntu/Debian machine:
#   sudo bash install-relay.sh

if [ "$(id -u)" -ne 0 ]; then
  echo "Error: must run as root (try: sudo bash $0)"
  exit 1
fi

echo "=== Tunnel Whisperer Relay Setup ==="
echo "Domain: {{.Domain}}"
echo ""

# ── Clean any previous installation (idempotent) ─────────────
# Re-running must not leak state from a prior install: stale per-tenant CA
# certs (an old server-id .crt left in the trust dir), an old Caddyfile or
# Xray config, a previous sshd drop-in, or leftover firewall rules (e.g. an
# "allow 22" from an earlier --ssh-open run when SSH is now tunnel-only).
# Host SSH keys and the OS are left untouched.
echo "[*] Cleaning previous installation..."
systemctl stop caddy 2>/dev/null || true
systemctl stop xray 2>/dev/null || true
rm -rf /etc/caddy/ca /etc/caddy/Caddyfile
rm -rf /usr/local/etc/xray
rm -f /etc/ssh/sshd_config.d/99-tw-localhost.conf
# Stale caddy repo bits: gpg --dearmor aborts on an existing keyring file
# under set -e, so a re-run died at step 3 until these were cleaned.
rm -f /usr/share/keyrings/caddy-stable-archive-keyring.gpg /etc/apt/sources.list.d/caddy-stable.list
if command -v ufw >/dev/null 2>&1; then ufw --force reset >/dev/null 2>&1 || true; fi

# ── Create SSH user ──────────────────────────────────────────
echo "[1/7] Creating SSH user '{{.SSHUser}}'..."
useradd -m -s /bin/bash {{.SSHUser}} 2>/dev/null || true
echo "{{.SSHUser}} ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/99-{{.SSHUser}}
mkdir -p /home/{{.SSHUser}}/.ssh
AK=/home/{{.SSHUser}}/.ssh/authorized_keys
touch "$AK"
# tw's management key is bound to the tunnel: from="127.0.0.1" means it only
# authenticates for connections arriving through the VLESS tunnel (which egress
# at localhost on the relay) — never over public port 22, even when 22 is open.
# Existing keys (e.g. your own maintenance key) are preserved; only a stale
# tw-key line is stripped so a re-run can't leave an unrestricted copy behind.
TW_PUBKEY='{{.PublicKey}}'
TW_KEYBODY=$(printf '%s' "$TW_PUBKEY" | awk '{print $2}')
if [ -n "$TW_KEYBODY" ]; then
  grep -vF "$TW_KEYBODY" "$AK" > "$AK.tmp" 2>/dev/null || true
  mv "$AK.tmp" "$AK"
fi
echo "from=\"127.0.0.1\" $TW_PUBKEY" >> "$AK"
chmod 700 /home/{{.SSHUser}}/.ssh
chmod 600 "$AK"
chown -R {{.SSHUser}}:{{.SSHUser}} /home/{{.SSHUser}}/.ssh

# ── Install packages ─────────────────────────────────────────
echo "[2/7] Installing packages..."
apt-get update -qq
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \
  debian-keyring debian-archive-keyring apt-transport-https curl ufw unzip

# ── Install Caddy ────────────────────────────────────────────
echo "[3/7] Installing Caddy..."
curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/gpg.key' \
  | gpg --yes --dearmor -o /usr/share/keyrings/caddy-stable-archive-keyring.gpg
curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/debian.deb.txt' \
  | tee /etc/apt/sources.list.d/caddy-stable.list > /dev/null
apt-get update -qq
DEBIAN_FRONTEND=noninteractive apt-get install -y -qq caddy

mkdir -p /etc/caddy/ca
echo '{{.CACertB64}}' | base64 -d > /etc/caddy/ca/{{.ServerID}}.crt
echo '{{.CaddyfileB64}}' | base64 -d > /etc/caddy/Caddyfile

# ── Install Xray (pinned version for reproducibility) ──────
echo "[4/7] Installing Xray {{.XrayVersion}}..."
bash -c "$(curl -L https://github.com/XTLS/Xray-install/raw/main/install-release.sh)" @ install --version {{.XrayVersion}}

mkdir -p /usr/local/etc/xray
echo '{{.XrayConfigB64}}' | base64 -d > /usr/local/etc/xray/config.json

# ── Configure SSH ────────────────────────────────────────────
{{if .SSHOpen}}echo "[5/7] Configuring SSH (public access, key-only)..."
cat > /etc/ssh/sshd_config.d/99-tw-localhost.conf <<'SSHEOF'
ListenAddress 0.0.0.0
PasswordAuthentication no
ClientAliveInterval 60
ClientAliveCountMax 5
SSHEOF
{{else}}echo "[5/7] Configuring SSH (localhost-only)..."
cat > /etc/ssh/sshd_config.d/99-tw-localhost.conf <<'SSHEOF'
ListenAddress 127.0.0.1
PasswordAuthentication no
ClientAliveInterval 60
ClientAliveCountMax 5
SSHEOF
{{end}}
# ── Firewall ─────────────────────────────────────────────────
echo "[6/7] Configuring firewall..."
ufw default deny incoming
ufw default allow outgoing
ufw allow 80/tcp
ufw allow 443/tcp
{{if .SSHOpen}}ufw allow 22/tcp
{{end}}ufw --force enable

# ── Start services ───────────────────────────────────────────
echo "[7/7] Starting services..."
systemctl restart ssh 2>/dev/null || systemctl restart sshd 2>/dev/null || true
systemctl enable xray
systemctl restart xray
systemctl restart caddy

PUBLIC_IP=$(curl -4s ifconfig.me 2>/dev/null || echo "could not detect")

echo ""
echo "=== Setup complete ==="
echo ""
echo "Public IP: ${PUBLIC_IP}"
echo ""
echo "Next steps:"
echo "  1. Set a DNS A record:  {{.Domain}}  ->  ${PUBLIC_IP}"
echo "  2. Go back to the Tunnel Whisperer dashboard and enter the IP above"
